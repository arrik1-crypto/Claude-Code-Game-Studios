[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_hitbox"
2d_physics/layer_5="enemy_hitbox"
2d_physics/layer_6="pickup"
2d_physics/layer_7="interactable"
2d_physics/layer_8="one_way"

[physics]

2d/default_gravity=900.0
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; Required for any Android export — Godot refuses the export outright without
; it, and silently: the validation sets its failure flag without a message.
; This only makes ETC2/ASTC *available* to textures that ask for VRAM
; compression. Every texture in this project imports at compress/mode=0
; (Lossless) and is therefore untouched, which is what keeps the pixel art
; crisp rather than block-compressed to mush.
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=false
anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0.043, 0.035, 0.062, 1)
