; Engine configuration file.
; Crimson Vespers — a gothic Metroidvania for mobile.
; Godot 4.6 — see docs/engine-reference/godot/VERSION.md

config_version=5

[application]

config/name="Crimson Vespers"
config/description="A gothic action-exploration Metroidvania set in Castle Vhorn."
config/version="0.1.0"
run/main_scene="res://src/core/boot.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://assets/art/ui/icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.043, 0.035, 0.062, 1)

[autoload]

EventBus="*res://src/core/event_bus.gd"
Balance="*res://src/core/balance.gd"
GameState="*res://src/core/game_state.gd"
AudioDirector="*res://src/core/audio_director.gd"
SceneDirector="*res://src/core/scene_director.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
; DisplayServer.SCREEN_SENSOR_LANDSCAPE. This is an enum, not a boolean, and the
; value that looks like "on" is the wrong one: SCREEN_PORTRAIT is 1, which is
; what this said until it was caught by decoding a built APK's manifest. Desktop
; ignores handheld orientation entirely, so a landscape-only game with a 16:9
; viewport and a two-thumb touch layout ran correctly everywhere except the one
; platform the setting exists for. 4 maps to Android's `sensorLandscape`, so the
; phone may be held either way up.
window/handheld/orientation=4
window/vsync/vsync_mode=1

[gui]

theme/custom_font="res://assets/fonts/alagard.ttf"

